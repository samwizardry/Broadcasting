@page "/watch"

<div class="watch-layout" id="watch-layout-main">

    <!-- Center Stream Player & Telemetry Column -->
    <div class="watch-layout__main">

        <!-- Back to Browse Bar -->
        <div class="watch-back-bar">
            <a href="/" class="btn-back-to-browse" id="btn-back-to-browse">
                ◀ BACK TO BROWSE CHANNELS
            </a>
            <div class="badge-telemetry">
                <span class="telemetry-indicator telemetry-indicator--green"></span>
                <span id="stream-viewers-display">24,850 VIEWERS</span>
            </div>
        </div>

        <StreamPlayer></StreamPlayer>
        @* <StreamMetadataHeader></StreamMetadataHeader> *@
        @* <StreamTelemetryWidget></StreamTelemetryWidget> *@

    </div>

    @* <LiveChatSidebar></LiveChatSidebar> *@

</div>