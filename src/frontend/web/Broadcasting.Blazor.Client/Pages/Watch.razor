@page "/watch/{slug}"

@using Broadcasting.Blazor.Client.HttpClients
@using Broadcasting.Contracts.Streaming
@implements IDisposable
@inject StreamingClient Streaming
@inject PersistentComponentState State

<div class="watch-layout" id="watch-layout-main">

    <!-- Center Stream Player & Telemetry Column -->
    <div class="watch-layout__main">

        <!-- Back to Browse Bar -->
        <div class="watch-back-bar">
            <a href="/" class="btn-back-to-browse" id="btn-back-to-browse">
                ◀ BACK TO BROWSE CHANNELS
            </a>
            <div class="badge-telemetry">
                <span class="telemetry-indicator telemetry-indicator--green"></span>
                <span id="stream-viewers-display">0 VIEWERS</span>
            </div>
        </div>

        @if (_channel is not null)
        {
            <StreamPlayer Channel="_channel"></StreamPlayer>
        }
        @* <StreamMetadataHeader></StreamMetadataHeader> *@
        @* <StreamTelemetryWidget></StreamTelemetryWidget> *@

    </div>

    @* <LiveChatSidebar></LiveChatSidebar> *@

</div>

@code {
    private StreamChannelResponse? _channel;
    private PersistingComponentStateSubscription _subscription;

    [Parameter]
    public string Slug { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        _subscription = State.RegisterOnPersisting(PersistData);

        if (!State.TryTakeFromJson(nameof(_channel), out _channel))
        {
            var response = await Streaming.GetChannelBySlugAsync(Slug);

            if (response.Succeeded)
            {
                _channel = response.Result!;
            }
        }

        await base.OnInitializedAsync();
    }

    private Task PersistData()
    {
        State.PersistAsJson(nameof(_channel), _channel);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _subscription.Dispose();
    }
}
