@using Broadcasting.Blazor.Client.Components.DropdownMenus
@using Broadcasting.Blazor.Client.HttpClients
@implements IDisposable

@inject NavigationManager NavigationManager
@inject ModalService ModalService

<header class="showcase-header">
    <a href="" class="brand-mark-group" title="Broadcasting">
        <div class="brand-crosshair">+</div>
        <div>
            <div class="brand-name">BROADCASTING</div>
        </div>
    </a>
    <nav class="cyber-tabs" role="tablist">
        <NavLink class="cyber-tabs__item" href="" Match="NavLinkMatch.All" ActiveClass="is-active" role="tab">
            <span>01 // BROWSE CHANNELS</span>
        </NavLink>
        <NavLink class="cyber-tabs__item" href="watch" ActiveClass="is-active" role="tab">
            <span>02 // WATCH STREAM</span>
        </NavLink>
    </nav>
    <div style="display: flex; align-items: center; gap: 10px;">
        <AuthorizeView>
            <NotAuthorized>
                <CyberButton Id="btn-header-login" Variant="ButtonVariant.Ghost" Size="Size.Sm"
                             data-modal-open="login-modal" title="Sign In to Broadcaster System"
                             OnClick="@(_ => ModalService.Open(ModalService.LoginModal))">
                    LOG IN
                </CyberButton>

                <CyberButton Id="btn-header-register" Variant="ButtonVariant.Primary" Size="Size.Sm"
                             data-modal-open="register-modal" title="Provision New Broadcaster Account"
                             OnClick="@(_ => ModalService.Open(ModalService.RegisterModal))">
                    REGISTER
                </CyberButton>
            </NotAuthorized>
        </AuthorizeView>
        <ProfileMenu></ProfileMenu>
    </div>
</header>

<AuthorizeView>
    <NotAuthorized>
        <LoginModal />
        <RegisterModal />
    </NotAuthorized>
</AuthorizeView>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
