@implements IDisposable

@inject NavigationManager NavigationManager

<header class="showcase-header">
    <a href="" class="brand-mark-group" title="Broadcasting UI Kit Home">
        <div class="brand-crosshair">+</div>
        <div>
            <div class="brand-name">BROADCASTING <span style="color: var(--accent-acid);">// UI KIT</span></div>
            <div class="brand-telemetry">[GRAPHIC REALISM // BROADCAST STUDIO]</div>
        </div>
    </a>

    <!-- Master View Switcher Tabs -->
    <nav class="cyber-tabs" role="tablist">
        <a href="index.html" class="cyber-tabs__item is-active" role="tab">
            <span>01 // BROWSE CHANNELS</span>
        </a>
        <a href="watch.html" class="cyber-tabs__item" role="tab">
            <span>02 // WATCH STREAM</span>
        </a>
        <a href="workbench.html" class="cyber-tabs__item" role="tab">
            <span>03 // COMPONENT WORKBENCH</span>
        </a>
        <a href="tokens.html" class="cyber-tabs__item" role="tab">
            <span>04 // DESIGN TOKENS</span>
        </a>
    </nav>

    <!-- Header Actions -->
    <div style="display: flex; align-items: center; gap: 10px;">
        <button id="btn-header-login" class="btn-cyber btn-cyber-ghost btn-cyber-sm" data-modal-open="login-modal" title="Sign In to Broadcaster System">
            LOG IN
        </button>

        <button id="btn-header-register" class="btn-cyber btn-cyber-primary btn-cyber-sm" data-modal-open="register-modal" title="Provision New Broadcaster Account">
            REGISTER
        </button>

        <div class="cyber-dropdown">
            <button class="btn-icon-hud" data-dropdown-toggle title="Broadcaster Profile">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            </button>
            <div class="cyber-dropdown__menu">
                <div class="cyber-dropdown__header">
                    <span>// PROFILE: SAMWIZARDRY</span>
                    <span>HOST.01</span>
                </div>
                <a href="#login" class="cyber-dropdown__item" data-modal-open="login-modal">
                    <span class="item-left">
                        <span class="item-tag" style="color: var(--accent-cyan); border-color: rgba(0, 245, 255, 0.3); background: var(--accent-cyan-dim);">[AUTH]</span>
                        <span>Operator Sign In</span>
                    </span>
                </a>
                <a href="#register" class="cyber-dropdown__item" data-modal-open="register-modal">
                    <span class="item-left">
                        <span class="item-tag" style="color: var(--accent-acid); border-color: rgba(216, 255, 0, 0.3); background: var(--accent-acid-dim);">[REG]</span>
                        <span>Register New Profile</span>
                    </span>
                </a>
                <div class="cyber-dropdown__divider"></div>
                <a href="#settings" class="cyber-dropdown__item" data-modal-open="stream-settings-modal">
                    <span class="item-left">
                        <span class="item-tag">[CFG]</span>
                        <span>Stream Ingest Settings</span>
                    </span>
                    <span class="item-shortcut">CTRL+S</span>
                </a>
                <a href="tokens.html" class="cyber-dropdown__item">
                    <span class="item-left">
                        <span class="item-tag" style="color: var(--accent-cyan); border-color: rgba(0, 245, 255, 0.3); background: var(--accent-cyan-dim);">[TEL]</span>
                        <span>Design System Tokens</span>
                    </span>
                </a>
                <div class="cyber-dropdown__divider"></div>
                <a href="#logout" class="cyber-dropdown__item" style="color: var(--accent-alert);">
                    <span class="item-left">
                        <span class="item-tag" style="color: var(--accent-alert); border-color: rgba(255, 51, 75, 0.3); background: var(--accent-alert-dim);">[OFF]</span>
                        <span>Disconnect Session</span>
                    </span>
                </a>
            </div>
        </div>
    </div>
</header>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}