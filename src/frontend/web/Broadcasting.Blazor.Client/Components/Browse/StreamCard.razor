@using Broadcasting.Blazor.Client.Components.Badges
@using Broadcasting.Contracts.Streaming
@inject NavigationManager Navigation

<article class="stream-card" data-open-stream="@StreamChannel.ChannelSlug" @onclick="OpenStream">
    <div class="stream-thumbnail-wrapper">
        <div class="stream-thumbnail-placeholder">
            <span class="preview-callsign">SYS.HUD // @Index.ToString("D2")</span>
        </div>
        <CyberBadgeLive>LIVE</CyberBadgeLive>
        <CyberBadgeViewers ViewerCount="0"></CyberBadgeViewers>
        <CyberBadgeResolution>1440P60</CyberBadgeResolution>
        <div class="stream-thumbnail__scanlines"></div>
    </div>
    <div class="stream-card-body">
        <div class="avatar-hud avatar-hud--live">@StreamChannel.Username.ToUpper()</div>
        <div class="stream-card-meta">
            <h3 class="stream-title">NO TITLE</h3>
            <div class="stream-author-row">
                <span class="author-name">@StreamChannel.Username</span>
            </div>
            <div class="stream-category">NO CATEGORY</div>
            <div class="tag-list">
                <span class="cyber-tag cyber-tag--acid">Crystal Clear</span>
                <span class="cyber-tag">Just Chatting</span>
            </div>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public StreamChannelResponse StreamChannel { get; set; }

    [Parameter, EditorRequired]
    public int Index { get; set; }

    private void OpenStream()
    {
        Navigation.NavigateTo($"watch/{StreamChannel.ChannelSlug}", false);
    }
}
