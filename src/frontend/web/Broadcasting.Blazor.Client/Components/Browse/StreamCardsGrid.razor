@using Broadcasting.Blazor.Client.HttpClients
@using Broadcasting.Contracts.Streaming
@implements IDisposable
@inject PersistentComponentState State
@inject StreamingClient Streaming
@inject ToastService Toast

<div>
    <div class="row-between" style="margin-bottom: 16px;">
        <h2 style="font-size: 14px; letter-spacing: 2px; color: var(--accent-acid);">
            // LIVE BROADCAST CHANNELS WITH REALTIME PREVIEW
        </h2>
        <span class="cyber-tag cyber-tag--cyan">5 CHANNELS ACTIVE</span>
    </div>
    <div class="cyber-grid cyber-grid--3col">

        @foreach (var channel in _channels ?? [])
        {
            <StreamCard></StreamCard>
        }
    </div>
</div>

@code {
    private List<StreamChannelResponse>? _channels;
    private PersistingComponentStateSubscription _subscription;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _subscription = State.RegisterOnPersisting(PersistData);
        if (!State.TryTakeFromJson<List<StreamChannelResponse>>(nameof(_channels), out _channels))
        {
            var response = await Streaming.GetLiveChannelsAsync();
            if (response.Succeeded)
            {
                _channels = response.Result!;
            }
            else
            {
                _channels = [];
                Toast.AddMessage(new ToastService.ToastMessage
                {
                    Variant = AlertVariant.Danger,
                    Message = response.GetErrorMessage('\n')
                });
            }
        }
    }

    private Task PersistData()
    {
        State.PersistAsJson(nameof(_channels), _channels);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _subscription.Dispose();
    }
}