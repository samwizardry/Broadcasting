@implements IDisposable
@inject ModalService ModalService

@code {
    protected bool _isOpen;
    private bool _shouldFocus;

    protected virtual string ModalId => throw new NotImplementedException();

    public void Dispose()
    {
        ModalService.OnChange -= HandleStateChange;
    }

    protected virtual ValueTask FocusAsync()
    {
        return ValueTask.CompletedTask;
    }

    protected override void OnInitialized()
    {
        ModalService.OnChange += HandleStateChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldFocus)
        {
            await Task.Delay(80);
            await FocusAsync();
            _shouldFocus = false;
        }
    }

    protected void HandleStateChange()
    {
        bool isOpen = ModalService.IsOpen(ModalId);
        if (_isOpen != isOpen)
        {
            _isOpen = isOpen;
            _shouldFocus = isOpen;
            StateHasChanged();
        }
    }

    protected void HandleKeyDown(KeyboardEventArgs e)
    {
        if (string.Equals(e.Key, "escape", StringComparison.OrdinalIgnoreCase))
        {
            ModalService.CloseAll();
        }
    }
}
