@inherits CyberModal
@inject ModalService ModalService

<div class="cyber-modal-backdrop @(_isOpen ? " is-open" : "")" id="@ModalService.RegisterModalId"
     tabindex="-1"
     @onclick="ModalService.CloseAll"
     @onkeydown="HandleKeyDown">

    <div class="cyber-modal" role="dialog" aria-modal="true" aria-labelledby="modal-register-title" @onclick:stopPropagation>

        <div class="cyber-modal__header">
            <h2 class="modal-title" id="modal-register-title">NEW BROADCASTER PROFILE // REGISTRATION</h2>
            <button class="btn-icon-hud btn-icon-hud--sm" data-modal-close title="Close Window" @onclick="ModalService.CloseAll">
                ✕
            </button>
        </div>

        <div class="cyber-modal__body">
            <div class="cyber-telemetry-banner cyber-telemetry-banner--acid">
                <span class="banner-badge">[REG.NEW]</span>
                <span>PROVISION NEW BROADCAST OPERATOR // MARATHON SPEC</span>
            </div>

            <form id="form-register" autocomplete="off" @onsubmit:preventDefault>
                <UsernameField Id="register-username"
                               Label="ASSIGN CALLSIGN / OPERATOR ID"
                               LabelCode="[CALLSIGN.ID]"
                               Placeholder="Enter unique operator callsign"
                               @bind-Value="_model.Username"
                               @ref="_usernameField" />

                <PasswordField Id="register-password"
                               Label="PRIMARY SECRET KEY"
                               LabelCode="[KEY.MIN_6]"
                               Placeholder="Minimum 6 characters"
                               @bind-Value="_model.Password"
                               style="margin-top: 14px;">
                    <Icon><Lock /></Icon>
                </PasswordField>

                <PasswordField Id="register-confirm"
                               Label="CONFIRM SECRET KEY"
                               LabelCode="[KEY.VERIFY]"
                               Placeholder="Confirm secret key"
                               @bind-Value="_model.ConfirmPassword"
                               style="margin-top: 14px;">
                    <Icon><Shield /></Icon>
                </PasswordField>

                <SwitchField Id="register-accept-terms"
                             Label="AGREE TO BROADCAST PROTOCOL & TERMS [TERMS]"
                             Checked="false"
                             Required="true"
                             @bind-Value="_model.AcceptTerms" />

                <div class="cyber-modal__footer" style="padding: 16px 0 0; background: transparent; border-top: 1px dashed var(--border-dim); margin-top: 16px;">
                    <button type="button" class="btn-cyber btn-cyber-ghost" data-modal-close @onclick="ModalService.CloseAll">CANCEL</button>
                    <button type="submit" class="btn-cyber btn-cyber-primary" id="btn-submit-register">
                        PROVISION ACCOUNT [CREATE.ID]
                    </button>
                </div>
            </form>
        </div>

        <div class="cyber-modal__switch">
            <span>ALREADY REGISTERED?</span>
            <button type="button" class="switch-link" data-modal-open="login-modal" @onclick="_ => ModalService.OpenModal(ModalService.LoginModalId)">LOG IN TO SYSTEM</button>
        </div>

    </div>
</div>

@code {
    public class RegisterModel
    {
        public string? Username { get; set; }

        public string? Password { get; set; }

        public string? ConfirmPassword { get; set; }

        public bool AcceptTerms { get; set; }
    }

    private UsernameField? _usernameField;

    private RegisterModel _model = new();

    protected override string ModalId => ModalService.RegisterModalId;

    protected override async ValueTask FocusAsync()
    {
        if (_usernameField is not null)
        {
            await _usernameField.FocusAsync();
        }
    }
}
