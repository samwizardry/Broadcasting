@using System.ComponentModel.DataAnnotations
@using Broadcasting.Blazor.Client.HttpClients
@using Broadcasting.Contracts.Blazor.Auth
@using Broadcasting.Contracts.Responses

@inherits CyberModal

@inject ModalService ModalService
@inject AuthClient AuthClient
@inject NavigationManager Navigation

<div class="cyber-modal-backdrop @(_isOpen ? "is-open" : "")" id="@ModalService.RegisterModalId"
     tabindex="-1"
     @onclick="ModalService.CloseAll"
     @onkeydown="HandleKeyDown">

    <div class="cyber-modal" role="dialog" aria-modal="true" aria-labelledby="modal-register-title" @onclick:stopPropagation>

        <div class="cyber-modal__header">
            <h2 class="modal-title" id="modal-register-title">NEW BROADCASTER PROFILE // REGISTRATION</h2>

            @* <CyberButton data-modal-close title="Close Window" OnClick="ModalService.CloseAll">✕</CyberButton> *@
            <button class="btn-icon-hud btn-icon-hud--sm" data-modal-close title="Close Window" @onclick="ModalService.CloseAll">✕</button>
        </div>

        <div class="cyber-modal__body">
            @if (_authError)
            {
                <TelemetryBanner Badge="@_telemetryBadge" Variant="danger" style="white-space: pre-line;">
                    @_telemetryMessage
                </TelemetryBanner>
            }
            else
            {
                <TelemetryBanner Badge="[REG.NEW]">
                    PROVISION NEW BROADCAST OPERATOR // MARATHON SPEC
                </TelemetryBanner>
            }
            <EditForm Model="_input" OnValidSubmit="HandleSubmit" id="form-register" autocomplete="off" novalidate>
                <DataAnnotationsValidator />
                <UsernameField Id="register-username"
                               Label="ASSIGN CALLSIGN / OPERATOR ID"
                               LabelCode="[CALLSIGN.ID]"
                               Placeholder="Enter unique operator callsign"
                               @bind-Value="_input.Username"
                               @ref="_usernameField" />

                <PasswordField Id="register-password"
                               Label="PRIMARY SECRET KEY"
                               LabelCode="[KEY.MIN_6]"
                               Placeholder="Minimum 6 characters"
                               @bind-Value="_input.Password"
                               style="margin-top: 14px;">
                    <Icon><LockIcon /></Icon>
                </PasswordField>

                <PasswordField Id="register-confirm"
                               Label="CONFIRM SECRET KEY"
                               LabelCode="[KEY.VERIFY]"
                               Placeholder="Confirm secret key"
                               @bind-Value="_input.ConfirmPassword"
                               style="margin-top: 14px;">
                    <Icon><ShieldIcon /></Icon>
                </PasswordField>

                <SwitchField Id="register-accept-terms"
                             Label="AGREE TO BROADCAST PROTOCOL & TERMS [TERMS]"
                             @bind-Value="_input.AcceptTerms" />
                <div class="cyber-modal__footer" style="padding: 16px 0 0; background: transparent; border-top: 1px dashed var(--border-dim); margin-top: 16px;">
                    <CyberButton data-modal-close OnClick="ModalService.CloseAll">CANCEL</CyberButton>
                    <CyberButton Id="btn-submit-register"
                                 Variant="ButtonVariant.Primary"
                                 ButtonType="ButtonType.Submit"
                                 Loading="_isLoading">PROVISION ACCOUNT [CREATE.ID]</CyberButton>
                </div>
            </EditForm>
        </div>

        <div class="cyber-modal__switch">
            <span>ALREADY REGISTERED?</span>
            @* <CyberButton data-modal-open="login-modal" OnClick="_ => ModalService.OpenModal(ModalService.LoginModalId)">LOG IN TO SYSTEM</CyberButton> *@
            <button type="button" class="switch-link" data-modal-open="login-modal" @onclick="_ => ModalService.OpenModal(ModalService.LoginModalId)">LOG IN TO SYSTEM</button>
        </div>
    </div>
</div>

@code {
    // Form
    private InputModel _input = new();
    // Focus element
    private UsernameField _usernameField = null!;
    // Submit button
    private bool _isLoading = false;

    // Telemetry banner
    private bool _authError = false;
    private string? _telemetryBadge;
    private string? _telemetryMessage;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override string ModalId => ModalService.RegisterModalId;

    protected override async ValueTask FocusAsync() => await _usernameField.FocusAsync();

    private async Task HandleSubmit()
    {
        _isLoading = true;

        try
        {
            var response = await AuthClient.RegisterAsync(
                new RegisterRequest(_input.Username, _input.Password, _input.AcceptTerms),
                CancellationToken);

            if (response.Succeeded)
            {
                _authError = false;
                ModalService.CloseAll();

                // TODO: alert
            }
            else
            {
                _authError = true;
                _telemetryBadge = "[REG.CRIT_ERR]";
                _telemetryMessage = response.GetErrorMessage('\n');
            }
        }
        catch (Exception ex)
        {
            _authError = true;
            _telemetryBadge = "[REG.CON_ERR]";
            _telemetryMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Callsign / Operator ID is required")]
        [Display(Name = "Username")]
        [StringLength(30, MinimumLength = 3, ErrorMessage = "Callsign must be 3-30 characters")]
        public string Username { get; set; } = "";

        [Required(ErrorMessage = "Secret key is required")]
        [Display(Name = "Password")]
        [DataType(DataType.Password)]
        [StringLength(100, MinimumLength = 6, ErrorMessage = "Key must be at least 6 characters")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Verification key is required")]
        [Display(Name = "Confirm password")]
        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "Secret keys do not match")]
        public string ConfirmPassword { get; set; } = "";

        [AllowedValues(true, ErrorMessage = "Protocol terms agreement is required")]
        public bool AcceptTerms { get; set; } = false;
    }
}
