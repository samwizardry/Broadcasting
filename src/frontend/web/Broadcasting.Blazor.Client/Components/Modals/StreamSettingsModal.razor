@using Broadcasting.Blazor.Client.HttpClients
@inherits Modal
@inject IJSRuntime JSRuntime
@inject ToastService Toast
@inject StreamingClient Streaming
@inject AuthenticationStateProvider AuthStateProvider

<div class="cyber-modal-backdrop @(_isOpen ? ModalService.IsOpenCssClass : "")" id="@ModalService.RegisterModalCssClass"
     tabindex="-1"
     @onclick="this.ModalService.CloseAll"
     @onkeydown="HandleKeyDown">
    <div class="cyber-modal" role="dialog" aria-modal="true" aria-labelledby="modal-stream-settings-title" @onclick:stopPropagation>
        <div class="cyber-modal__header">
            <h2 class="modal-title" id="modal-stream-settings-title">STREAM INGESTION & HARDWARE ENCODING</h2>
            <button class="btn-icon-hud btn-icon-hud--sm" data-modal-close title="Close Window" @onclick="this.ModalService.CloseAll">
                ✕
            </button>
        </div>
        <div class="cyber-modal__body">
            <div class="cyber-field">
                <label class="cyber-field__label">
                    <span>PRIMARY STREAM SECRET KEY</span>
                    <span class="label-code">[SECRET]</span>
                </label>
                <div class="cyber-stream-key" data-stream-key-wrapper>
                    <input type="@(_showStreamSecretKey ? "text" : "password")" class="key-value" value="@_streamSecretKey" readonly>
                    <div class="key-actions">
                        <button class="btn-cyber btn-cyber-secondary btn-cyber-sm" data-key-toggle
                            @onclick="@(_ => _showStreamSecretKey = !_showStreamSecretKey)">
                            @(_showStreamSecretKey ? "HIDE" : "SHOW")
                        </button>
                        <button class="btn-cyber btn-cyber-primary btn-cyber-sm" data-key-copy @onclick="CopyStreamSecretKey">COPY</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="cyber-modal__footer">
            <CyberButton data-modal-close OnClick="this.ModalService.CloseAll">CANCEL</CyberButton>
        </div>
    </div>
</div>

@code {
    private bool _showStreamSecretKey;
    private string? _streamSecretKey;

    protected override int ModalId => ModalService.StreamSettingsModal;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var response = await Streaming.GetStreamSettingsAsync(authState.User.Identity!.Name!, CancellationToken);

        if (response.Succeeded)
        {
            _streamSecretKey = response.Result!.StreamSecretKey;
        }
        else
        {
            Toast.AddMessage(new ToastService.ToastMessage()
            {
                Variant = AlertVariant.Warning,
                Message = response.GetErrorMessage('\n')
            });
        }
    }

    private async Task CopyStreamSecretKey()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _streamSecretKey);
        Toast.AddMessage(new ToastService.ToastMessage()
        {
            Variant = AlertVariant.Success,
            Message = "STREAM KEY COPIED TO CLIPBOARD"
        });
    }
}
