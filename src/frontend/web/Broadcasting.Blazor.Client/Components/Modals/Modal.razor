@implements IDisposable

@code {
    private bool _shouldFocus;
    private CancellationTokenSource _cts = new();

    protected bool _isOpen;

    [Inject] protected ModalService ModalService { get; set; } = default!;
    protected virtual int ModalId => throw new NotImplementedException();
    protected CancellationToken CancellationToken => _cts.Token;

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        this.ModalService.OnChange -= HandleStateChange;
    }

    protected virtual ValueTask FocusAsync()
    {
        return ValueTask.CompletedTask;
    }

    protected virtual void Reset() { }

    protected override void OnInitialized()
    {
        this.ModalService.OnChange += HandleStateChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldFocus)
        {
            await Task.Delay(80);
            await FocusAsync();
            _shouldFocus = false;
        }
    }

    protected void HandleStateChange()
    {
        bool isOpen = this.ModalService.IsOpen(ModalId);
        if (isOpen)
        {
            Reset();
        }

        if (_isOpen != isOpen)
        {
            _isOpen = isOpen;
            _shouldFocus = isOpen;
            StateHasChanged();
        }
    }

    protected void HandleKeyDown(KeyboardEventArgs e)
    {
        if (string.Equals(e.Key, "escape", StringComparison.OrdinalIgnoreCase))
        {
            this.ModalService.CloseAll();
        }
    }
}
