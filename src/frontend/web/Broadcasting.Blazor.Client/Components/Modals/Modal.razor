@implements IDisposable

@code {
    private bool _shouldOpen;
    private CancellationTokenSource _cts = new();

    protected bool _isOpen;

    [Inject] protected ModalService ModalService { get; set; } = default!;

    protected virtual int ModalId => throw new NotImplementedException();
    protected CancellationToken CancellationToken => _cts.Token;

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        this.ModalService.OnChange -= HandleStateChange;
    }

    protected virtual ValueTask OnFocusAsync()
    {
        return ValueTask.CompletedTask;
    }

    protected virtual Task OnOpenAsync()
    {
        return Task.CompletedTask;
    }

    protected virtual void Reset() { }

    protected override void OnInitialized()
    {
        this.ModalService.OnChange += HandleStateChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldOpen)
        {
            _shouldOpen = false;
            await OnOpenAsync();
            await Task.Delay(80);
            await OnFocusAsync();
        }
    }

    protected void HandleStateChange()
    {
        bool isOpen = this.ModalService.IsOpen(ModalId);
        if (isOpen)
        {
            Reset();
        }

        if (_isOpen != isOpen)
        {
            _isOpen = isOpen;
            _shouldOpen = isOpen;
            StateHasChanged();
        }
    }

    protected void HandleKeyDown(KeyboardEventArgs e)
    {
        if (string.Equals(e.Key, "escape", StringComparison.OrdinalIgnoreCase))
        {
            this.ModalService.CloseAll();
        }
    }
}
