@using System.Diagnostics.CodeAnalysis
@inherits InputBase<string>

<div class="cyber-field" @attributes="AdditionalAttributes">
    <label class="cyber-field__label" for="@Id">
        <span>@Label</span>
        <span class="label-code">@LabelCode</span>
    </label>
    <div class="cyber-input-group cyber-input-group--has-suffix">
        <span class="input-prefix-icon">
            @Icon
        </span>
        <input type="@(_showPassword ? "text" : "password")" id="@Id" class="cyber-input" placeholder="@Placeholder" required @oninput="HandleInput">
        <button type="button" class="btn-cyber btn-cyber-secondary btn-cyber-sm input-suffix-action" data-password-toggle="@Id" @onclick="_ => _showPassword = !_showPassword">
            @(_showPassword ? "HIDE" : "SHOW")
        </button>
    </div>
</div>

@code {
    private bool _showPassword;

    [Parameter, EditorRequired] public string Id { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; }
    [Parameter, EditorRequired] public string LabelCode { get; set; }
    [Parameter, EditorRequired] public string Placeholder { get; set; }
    [Parameter, EditorRequired] public RenderFragment Icon { get; set; }

    protected override bool TryParseValueFromString(
        string? value,
        [MaybeNullWhen(false)] out string result,
        [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = value ?? "";
        validationErrorMessage = null;
        return true;
    }

    private void HandleInput(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
    }
}
