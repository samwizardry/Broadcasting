<article class="cyber-player" id="main-stream-player">
    <div class="player-scanlines"></div>
    <div class="player-overlay-crosshair"></div>

    <!-- Top Telemetry HUD -->
    <div class="player-hud-top">
        <div class="hud-meta-left">
            <span class="badge-live">LIVE BROADCAST</span>
            <span class="hud-pill" id="stream-hud-pill">CH_SAMWIZARDRY // LIVE</span>
        </div>
        <div class="hud-meta-right">
            <span class="hud-pill" style="color: var(--accent-acid);">1080P // 60FPS</span>
            <span class="hud-pill">DROP: 0.00%</span>
            <span class="hud-pill">EU-CENTRAL-01</span>
        </div>
    </div>

    <!-- Center Interactive Play Action -->
    <div class="player-center-action" id="player-center-play">
        <div class="play-btn-large">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
        </div>
        <span class="play-label">START BROADCAST FEED</span>
    </div>

    <div class="player-screen" id="player-active-screen">
        <div style="font-family: var(--font-hud); font-size: 18px; letter-spacing: 3px; color: var(--accent-cyan); text-align: center;">
            BROADCASTING STREAM ONLINE
            <div style="font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); margin-top: 6px;">
                WEBRTC ULTRA LOW-LATENCY INGEST // AUDIO 48KHZ STEREO
            </div>
        </div>
    </div>

    <!-- Bottom Playback Controls Bar -->
    <div class="player-controls">
        <div class="controls-timeline">
            <div class="timeline-buffered"></div>
            <div class="timeline-progress"></div>
        </div>
        <div class="controls-bar">
            <div class="controls-left">
                <button class="btn-player-control" id="player-bottom-play" title="Play / Pause">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                </button>

                <span class="live-status-chip">
                    <span class="live-dot"></span> LIVE
                </span>

                <button class="btn-player-control" title="Volume">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                        <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                    </svg>
                </button>

                <span class="time-readout">01:42:18 // LIVE</span>
            </div>

            <div class="controls-right">
                <span class="cyber-tag cyber-tag--acid">AV1</span>
                <span class="cyber-tag cyber-tag--cyan">1080P60</span>

                <button class="btn-player-control" title="Settings" data-modal-open="stream-settings-modal">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                    </svg>
                </button>

                <button class="btn-player-control" title="Fullscreen">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</article>