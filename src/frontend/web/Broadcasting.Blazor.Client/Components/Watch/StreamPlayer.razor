@using Broadcasting.Contracts.Streaming
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<article class="cyber-player" id="main-stream-player">
    <div class="player-scanlines"></div>
    <div class="player-overlay-crosshair"></div>

    <!-- Top Telemetry HUD -->
    <div class="player-hud-top">
        <div class="hud-meta-left">
            <span class="badge-live" id="statusOverlay">LIVE BROADCAST</span>
            <span class="hud-pill" id="stream-hud-pill">CH_@(Channel.Username.ToUpper()) // LIVE</span>
        </div>
        <div class="hud-meta-right">
            <span class="hud-pill" style="color: var(--accent-acid);">1440P // 60FPS</span>
            <span class="hud-pill">DROP: 0.00%</span>
            <span class="hud-pill">EU-CENTRAL-01</span>
        </div>
    </div>

    <!-- Center Interactive Play Action -->
    <div class="player-center-action" id="player-center-play">
        <div class="play-btn-large">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
        </div>
        <span class="play-label" id="player-center-label">START BROADCAST FEED [LIVE EDGE]</span>
    </div>

    <!-- Live HTML5 Video Stream Element -->
    <video id="videoPlayer"
           class="player-video"
           data-stream-src="@Channel.HlsAddress"
           autoplay
           muted
           playsinline></video>

    <!-- Standby / Telemetry Backdrop -->
    <div class="player-screen" id="player-active-screen">
        <div style="font-family: var(--font-hud); font-size: 18px; letter-spacing: 3px; color: var(--accent-cyan); text-align: center;">
            BROADCASTING STREAM ONLINE
            <div id="player-screen-subtitle" style="font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); margin-top: 6px;">
                HLS / WEBRTC LOW-LATENCY INGEST // AUDIO 48KHZ STEREO
            </div>
        </div>
    </div>

    <!-- Bottom Playback Controls Bar (Play/Pause + Live Edge Sync Only, No Duration Bar) -->
    <div class="player-controls">
        <div class="controls-bar">
            <div class="controls-left">
                <button type="button" class="btn-player-control" id="player-bottom-play" title="Play (Sync to Live Edge) / Pause [SPACE]" aria-label="Play or Pause Stream">
                    <svg class="icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                    <svg class="icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <rect x="6" y="4" width="4" height="16"></rect>
                        <rect x="14" y="4" width="4" height="16"></rect>
                    </svg>
                    <span class="control-label" id="player-play-label">PLAY</span>
                </button>

                <span class="live-status-chip" id="player-live-sync">
                    <span class="live-dot"></span>
                    <span id="player-live-chip-text">LIVE</span>
                </span>

                <div class="player-volume-group">
                    <button type="button" class="btn-player-control" id="player-mute-btn" title="Mute / Unmute Audio [M]" aria-label="Mute or Unmute">
                        <svg class="icon-volume-on" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
                            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                            <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                        </svg>
                        <svg class="icon-volume-muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                            <line x1="23" y1="9" x2="17" y2="15"></line>
                            <line x1="17" y1="9" x2="23" y2="15"></line>
                        </svg>
                    </button>
                    <input type="range"
                           id="player-volume-slider"
                           class="cyber-slider player-volume-slider"
                           min="0"
                           max="100"
                           step="1"
                           value="0"
                           aria-label="Stream Volume">
                    <span class="volume-readout" id="player-volume-value">0%</span>
                </div>

                <span class="time-readout" id="player-sync-readout">SYNC // LIVE EDGE</span>
            </div>

            <div class="controls-right">
                <span class="cyber-tag cyber-tag--acid">AV1</span>
                <span class="cyber-tag cyber-tag--cyan">1440P60</span>

                @* <button type="button" class="btn-player-control" title="Stream Settings" data-modal-open="stream-settings-modal">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                    </svg>
                </button> *@

                <button type="button" class="btn-player-control" id="player-fullscreen-btn" title="Toggle Fullscreen [F]" aria-label="Toggle Fullscreen">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</article>

@code {
    private IJSObjectReference? _module;

    [Parameter, EditorRequired]
    public StreamChannelResponse Channel { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./Components/Watch/StreamPlayer.razor.js");
            await _module.InvokeVoidAsync("init");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
    }
}
