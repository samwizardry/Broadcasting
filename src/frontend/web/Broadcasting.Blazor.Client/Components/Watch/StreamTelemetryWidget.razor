<div class="stream-health-widget" style="margin-top: 16px;">
    <div class="stream-health-widget__header">
        <span class="health-title">// NETWORK & BITRATE TELEMETRY</span>
        <span class="cyber-tag cyber-tag--acid">STATUS: OPTIMAL</span>
    </div>
    <div class="bitrate-graph-container">
        <div class="graph-grid-lines"></div>
        <svg class="bitrate-svg-sparkline" viewBox="0 0 300 60" preserveAspectRatio="none">
            <polygon points="0,60 0,38 30,35 60,32 90,36 120,28 150,30 180,24 210,26 240,22 270,25 300,20 300,60" />
            <polyline points="0,38 30,35 60,32 90,36 120,28 150,30 180,24 210,26 240,22 270,25 300,20" />
        </svg>
    </div>
    <div class="health-metrics-grid" style="grid-template-columns: repeat(6, 1fr);">
        <div class="metric-cell">
            <span class="metric-name">FPS</span>
            <span class="metric-val metric-val--acid">60.0</span>
        </div>
        <div class="metric-cell">
            <span class="metric-name">BITRATE</span>
            <span class="metric-val metric-val--cyan">8,450 kbps</span>
        </div>
        <div class="metric-cell">
            <span class="metric-name">DROP RATE</span>
            <span class="metric-val">0.00%</span>
        </div>
        <div class="metric-cell">
            <span class="metric-name">RTT LATENCY</span>
            <span class="metric-val metric-val--acid">0.84 SEC</span>
        </div>
        <div class="metric-cell">
            <span class="metric-name">CODEC</span>
            <span class="metric-val">AV1 / OPUS</span>
        </div>
        <div class="metric-cell">
            <span class="metric-name">SECURITY</span>
            <span class="metric-val metric-val--cyan">TLS 1.3 / E2E</span>
        </div>
    </div>
</div>