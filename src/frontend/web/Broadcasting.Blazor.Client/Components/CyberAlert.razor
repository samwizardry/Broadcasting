<div class="cyber-alert cyber-alert--@Variant.ToLowerString()">
    <span class="cyber-alert__badge">[@(BadgeCode ?? Variant.ToCode())]</span>
    <div class="cyber-alert__content">
        <div class="alert-header">
            @if (!string.IsNullOrEmpty(Title))
            {
                <span class="alert-title">// @Title</span>
            }
            @if (!string.IsNullOrEmpty(TelemetryCode))
            {
                <span class="alert-code">@TelemetryCode</span>
            }
        </div>
        @if (ChildContent is not null)
        {
            <span class="alert-desc">@ChildContent</span>
        }
    </div>
</div>

@code {
    [Parameter]
    public AlertVariant Variant { get; set; } = AlertVariant.Info;

    [Parameter]
    public string? BadgeCode { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? TelemetryCode { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
