<h3>CyberAlert</h3>

<div class="cyber-alert cyber-alert--@GetAlertType(Type)">
    <span class="cyber-alert__badge">[@GetBadgeCode(Type)]</span>
    <div class="cyber-alert__content">
        <div class="alert-header">
            @if (!string.IsNullOrEmpty(Title))
            {
                <span class="alert-title">// @Title</span>
            }
            @if (!string.IsNullOrEmpty(TelemetryCode))
            {
                <span class="alert-code">@TelemetryCode</span>
            }
        </div>
        @if (ChildContent is not null)
        {
            <span class="alert-desc">@ChildContent</span>
        }
    </div>
</div>

@code {
    public enum AlertType
    {
        Info,
        Success,
        Warning,
        Danger
    }

    [Parameter]
    public AlertType Type { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? TelemetryCode { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private static string GetAlertType(AlertType type)
        => type switch
        {
            AlertType.Info => "info",
            AlertType.Success => "success",
            AlertType.Warning => "warning",
            AlertType.Danger => "danger",
            _ => throw new ArgumentException($"Alert type {type} is not supported.")
        };

    private static string GetBadgeCode(AlertType type)
        => type switch
        {
            AlertType.Info => "SYS.INFO",
            AlertType.Success => "VERIFIED",
            AlertType.Warning => "WARN_08",
            AlertType.Danger => "CRIT_ERR",
            _ => throw new ArgumentException($"Alert type {type} is not supported.")
        };
}
