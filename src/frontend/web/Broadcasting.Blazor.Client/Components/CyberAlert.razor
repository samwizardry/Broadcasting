<div class="cyber-alert cyber-alert--@Variant.ToLowerString()" @attributes="AdditionalAttributes"
     style="min-width: 280px; box-shadow: rgba(0, 0, 0, 0.8) 0px 8px 30px; pointer-events: auto; animation: 0.25s cubic-bezier(0.2, 0.8, 0.2, 1) 0s 1 normal none running cyber-toast-in; @(IsFadingOut ? "opacity: 0; transform: translateY(8px); transition: opacity 0.2s, transform 0.2s;" : "")">
    <span class="cyber-alert__badge">[@(BadgeCode ?? Variant.ToCode())]</span>
    <div class="cyber-alert__content">
        <div class="alert-header">
            @if (!string.IsNullOrEmpty(Title))
            {
                <span class="alert-title">// @Title</span>
            }
            @if (!string.IsNullOrEmpty(TelemetryCode))
            {
                <span class="alert-code">@TelemetryCode</span>
            }
        </div>
        @if (ChildContent is not null)
        {
            <span class="alert-desc" style="white-space: pre-line;">@ChildContent</span>
        }
    </div>
</div>

@code {
    [Parameter]
    public AlertVariant Variant { get; set; } = AlertVariant.Info;

    [Parameter]
    public string? BadgeCode { get; set; }

    [Parameter]
    public string? Title { get; set; } = "TELEMETRY ALERT";

    [Parameter]
    public string? TelemetryCode { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool IsFadingOut { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
