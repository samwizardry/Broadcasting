@inherits DropdownMenu
@inject ModalService Modal

<div class="cyber-dropdown"
     tabindex="-1"
     style="outline: none;"
     @onmousedown:preventDefault
     @onkeydown="HandleKeyDown"
     @onblur="HandleBlur"
     @ref="_menu">
    <button class="btn-icon-hud" data-dropdown-toggle title="Broadcaster Profile"
            @onclick="HandleOpen">
        <PersonIcon Width="18" Height="18" />
    </button>
    <div class="cyber-dropdown__menu @(_isOpen ? DropdownMenuService.IsOpenCssClass : "")">
        <AuthorizeView>
            <Authorized>
                <div class="cyber-dropdown__header">
                    <span>// PROFILE: @context.User.Identity!.Name!.ToUpper()</span>
                    <span>HOST.01</span>
                </div>
                <div class="cyber-dropdown__divider"></div>
                <a href="#settings" class="cyber-dropdown__item" data-modal-open="stream-settings-modal"
                    @onclick="_ => Modal.Open(ModalService.StreamSettingsModal)">
                    <span class="item-left">
                        <span class="item-tag">[CFG]</span>
                        <span>Stream Ingest Settings</span>
                    </span>
                    <span class="item-shortcut">CTRL+S</span>
                </a>
                <form action="/auth/logout" method="post" data-enhance="false">
                    <AntiforgeryToken />
                    <button type="submit" class="cyber-dropdown__item" style="color: var(--accent-alert);">
                        <span class="item-left">
                            <span class="item-tag" style="color: var(--accent-alert); border-color: rgba(255, 51, 75, 0.3); background: var(--accent-alert-dim);">[OFF]</span>
                            <span>Disconnect Session</span>
                        </span>
                    </button>
                </form>
            </Authorized>
            <NotAuthorized>
                <div class="cyber-dropdown__header">
                    <span>// PROFILE: ANONYMOUS</span>
                    <span>HOST.01</span>
                </div>
                <button class="cyber-dropdown__item" data-modal-open="login-modal" @onclick="_ => Modal.Open(ModalService.LoginModal)">
                    <span class="item-left">
                        <span class="item-tag" style="color: var(--accent-cyan); border-color: rgba(0, 245, 255, 0.3); background: var(--accent-cyan-dim);">[AUTH]</span>
                        <span>Operator Sign In</span>
                    </span>
                </button>
                <button class="cyber-dropdown__item" data-modal-open="register-modal" @onclick="_ => Modal.Open(ModalService.RegisterModal)">
                    <span class="item-left">
                        <span class="item-tag" style="color: var(--accent-acid); border-color: rgba(216, 255, 0, 0.3); background: var(--accent-acid-dim);">[REG]</span>
                        <span>Register New Profile</span>
                    </span>
                </button>
            </NotAuthorized>
        </AuthorizeView>
        <form action="/auth/purge" method="post" data-enhance="false" style="display: none;">
            <button type="submit" class="cyber-dropdown__item" style="color: var(--accent-alert);">
                <span class="item-left">
                    <span class="item-tag" style="color: var(--accent-alert); border-color: rgba(255, 51, 75, 0.3); background: var(--accent-alert-dim);">[OFF]</span>
                    <span>Purge</span>
                </span>
            </button>
        </form>
    </div>
</div>

@code {
    protected override int MenuId => DropdownMenuService.ProfileMenu;
}
