@implements IDisposable

@code {
    private bool _shouldFocus = false;
    private CancellationTokenSource _cts = new();

    protected bool _isOpen;
    protected ElementReference _menu;

    [Inject] protected DropdownMenuService MenuService { get; set; } = default!;

    protected virtual int MenuId => throw new NotImplementedException();
    protected CancellationToken CancellationToken => _cts.Token;

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        MenuService.OnChange -= HandleStateChange;
    }

    protected async ValueTask FocusAsync()
    {
        await _menu.FocusAsync();
    }

    protected void HandleBlur()
    {
        if (_isOpen)
        {
            MenuService.CloseAll();
        }
    }

    protected override void OnInitialized()
    {
        MenuService.OnChange += HandleStateChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldFocus)
        {
            await FocusAsync();
            _shouldFocus = false;
        }
    }

    protected void HandleStateChange()
    {
        bool isOpen = MenuService.IsOpen(MenuId);

        if (_isOpen != isOpen)
        {
            _isOpen = isOpen;
            _shouldFocus = _isOpen;
            StateHasChanged();
        }
    }

    protected void HandleKeyDown(KeyboardEventArgs e)
    {
        if (string.Equals(e.Key, "escape", StringComparison.OrdinalIgnoreCase))
        {
            MenuService.CloseAll();
        }
    }

    protected void HandleOpen()
    {
        if (_isOpen)
        {
            MenuService.CloseAll();
        }
        else
        {
            MenuService.Open(MenuId);
        }
    }
}
